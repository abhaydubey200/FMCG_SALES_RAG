# ═══════════════════════════════════════════════════════════════
# Sales & Marketing Intelligence Platform — Environment Config
# Copy to .env and fill in values
# ═══════════════════════════════════════════════════════════════

# ── Application ──
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# ── PostgreSQL ──
DATABASE_URL=postgresql://ragsql:ragsql_secret_dev@postgres:5432/ragsql
POSTGRES_DB=ragsql
POSTGRES_USER=ragsql
POSTGRES_PASSWORD=ragsql_secret_dev

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── LLM Provider ──
LLM_BACKEND=fallback
# LLM_BACKEND=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=

# ── Embeddings ──
EMBEDDING_BACKEND=tfidf
# EMBEDDING_BACKEND=neural
# NEURAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── API ──
API_HOST=0.0.0.0
API_PORT=8000

# ── Frontend ──
FRONTEND_PORT=8501

# ── Nginx ──
NGINX_PORT=80
