# ============================================================
# APPLICATION
# ============================================================

# Application environment
APP_ENV=development

# Application name
APP_NAME=Amazon Sales & Marketing Intelligence Platform

# Backend API URL
# UPDATE THIS if your backend runs on another host/port
API_BASE_URL=http://localhost:8000

# Frontend URL
# UPDATE THIS if your frontend runs on another host/port
FRONTEND_URL=http://localhost:5173

# API port
API_PORT=8000


# ============================================================
# SUPABASE
# ============================================================

# Supabase project URL
# This is safe to use by the frontend.
SUPABASE_URL=https://rqhztljqzbtvxxftmstp.supabase.co

# Supabase publishable key
# Safe for frontend usage when RLS is correctly configured.
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Backward-compatible alias if the existing application expects
# SUPABASE_KEY.
# Remove this if the application does not use it.
SUPABASE_KEY=your_supabase_publishable_key_here

# ============================================================
# VERY IMPORTANT:
# This is the Supabase SECRET key.
#
# SERVER/BACKEND ONLY.
# NEVER expose this to React/browser code.
# NEVER prefix this with VITE_ or NEXT_PUBLIC_.
#
# ROTATE THE PREVIOUS KEY YOU SHARED BEFORE USING IT.
# ============================================================
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Supabase Auth JWKS endpoint
SUPABASE_JWKS_URL=https://rqhztljqzbtvxxftmstp.supabase.co/auth/v1/.well-known/jwks.json


# ============================================================
# SUPABASE POSTGRESQL
# ============================================================

# IMPORTANT:
# Get the correct connection string from:
# Supabase Dashboard
# → Connect
# → PostgreSQL
#
# Do not construct this manually if Supabase provides a pooler
# connection string for your deployment.
#
# UPDATE THIS VALUE.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DATABASE_PASSWORD@YOUR_DATABASE_HOST:5432/postgres

# Optional synchronous database URL for migration tools.
# UPDATE THIS if Alembic requires a separate synchronous URL.
DATABASE_SYNC_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@YOUR_DATABASE_HOST:5432/postgres

# Database host
# UPDATE THIS if needed.
POSTGRES_HOST=db.rqhztljqzbtvxxftmstp.supabase.co

# PostgreSQL port
POSTGRES_PORT=5432

# PostgreSQL database
POSTGRES_DB=postgres

# PostgreSQL username
POSTGRES_USER=postgres

# PostgreSQL password
# UPDATE THIS.
# NEVER commit this value.
POSTGRES_PASSWORD=your_database_password_here


# ============================================================
# PGVECTOR
# ============================================================

# Enable vector search
VECTOR_ENABLED=true

# Embedding model
# UPDATE if you choose another embedding model.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# IMPORTANT:
# This must match the dimension produced by your embedding model.
#
# bge-small-en-v1.5 = 384 dimensions
EMBEDDING_DIMENSION=384

# Number of documents/chunks retrieved initially
RAG_TOP_K=10

# Number of chunks passed to final reasoning
RAG_CONTEXT_TOP_K=5

# Minimum similarity threshold.
# Tune this after evaluation.
RAG_SIMILARITY_THRESHOLD=0.65


# ============================================================
# RAG
# ============================================================

# Chunk size
RAG_CHUNK_SIZE=800

# Chunk overlap
RAG_CHUNK_OVERLAP=120

# Retrieval mode:
# vector
# hybrid
# keyword
RAG_RETRIEVAL_MODE=hybrid

# Enable reranking
RAG_RERANKING_ENABLED=true

# Maximum document size in MB
MAX_DOCUMENT_SIZE_MB=25

# Maximum dataset size in MB
MAX_DATASET_SIZE_MB=100


# ============================================================
# LLM
# ============================================================

# Provider:
# groq
# nvidia
# ollama
# openrouter
# etc.
#
# UPDATE THIS according to the provider you are using.
LLM_PROVIDER=groq

# Model name
# UPDATE THIS with the model you actually select.
LLM_MODEL=PASTE_MODEL_NAME_HERE

# API key
# UPDATE THIS.
#
# NEVER expose this to frontend.
LLM_API_KEY=your_llm_api_key_here

# LLM temperature
LLM_TEMPERATURE=0.1

# Maximum output tokens
LLM_MAX_TOKENS=2048

# Request timeout
LLM_TIMEOUT_SECONDS=60


# ============================================================
# OPTIONAL GROQ CONFIGURATION
# ============================================================

# Only required if LLM_PROVIDER=groq
# UPDATE THIS.
GROQ_API_KEY=your_groq_api_key_here

# UPDATE THIS if using a specific Groq endpoint/model.
GROQ_MODEL=PASTE_GROQ_MODEL_HERE


# ============================================================
# OPTIONAL OLLAMA CONFIGURATION
# ============================================================

# Only required if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# UPDATE THIS if using Ollama.
OLLAMA_MODEL=PASTE_OLLAMA_MODEL_HERE


# ============================================================
# EMBEDDING SERVICE
# ============================================================

# Embedding provider:
# local
# huggingface
# openai
# etc.
EMBEDDING_PROVIDER=local

# If using local Hugging Face/Sentence Transformers,
# no API key is required.
#
# UPDATE if using a remote embedding provider.
EMBEDDING_API_KEY=

# Optional embedding endpoint
EMBEDDING_BASE_URL=


# ============================================================
# SUPABASE STORAGE
# ============================================================

# Bucket for datasets
SUPABASE_DATASET_BUCKET=datasets

# Bucket for documents
SUPABASE_DOCUMENT_BUCKET=documents

# Keep buckets private.
SUPABASE_STORAGE_PRIVATE=true


# ============================================================
# REDIS
# ============================================================

# Redis is optional if background processing is not implemented.
REDIS_ENABLED=true

REDIS_HOST=localhost

REDIS_PORT=6379

REDIS_DB=0

REDIS_PASSWORD=

# Complete Redis URL
REDIS_URL=redis://localhost:6379/0


# ============================================================
# BACKGROUND WORKER
# ============================================================

# Enable asynchronous ingestion.
WORKER_ENABLED=true

# Number of concurrent ingestion jobs
WORKER_CONCURRENCY=2

# Job timeout
WORKER_TIMEOUT_SECONDS=600


# ============================================================
# FILE UPLOAD
# ============================================================

# Maximum CSV/XLSX file size
MAX_UPLOAD_SIZE_MB=100

# Allowed extensions
ALLOWED_DATA_EXTENSIONS=.csv,.xlsx

# Allowed document extensions
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.txt,.md


# ============================================================
# SECURITY
# ============================================================

# Generate a strong random value for production.
# UPDATE THIS.
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET_HERE

# JWT issuer / Supabase Auth
JWT_ISSUER=https://rqhztljqzbtvxxftmstp.supabase.co/auth/v1

# JWT audience
JWT_AUDIENCE=authenticated

# Access token expiration handling
JWT_VERIFY_EXPIRATION=true


# ============================================================
# CORS
# ============================================================

# Comma-separated frontend origins.
#
# UPDATE THIS for your deployment.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Do not use "*" in production when credentials are enabled.
CORS_ALLOW_CREDENTIALS=true


# ============================================================
# ANALYTICS
# ============================================================

# Enable structured analytics
ANALYTICS_ENABLED=true

# Enable natural-language-to-SQL
NL_SQL_ENABLED=true

# Read-only SQL enforcement
SQL_READ_ONLY=true

# Maximum query execution time
SQL_QUERY_TIMEOUT_SECONDS=30

# Maximum returned rows
SQL_MAX_ROWS=10000


# ============================================================
# AI QUERY ROUTING
# ============================================================

# Enable query classification
AI_QUERY_ROUTING_ENABLED=true

# Supported routing:
# knowledge
# analytics
# hybrid
# unanswerable
# ambiguous

AI_ROUTING_CONFIDENCE_THRESHOLD=0.70


# ============================================================
# AI SAFETY
# ============================================================

# Prevent retrieved documents from overriding system instructions.
PROMPT_INJECTION_PROTECTION=true

# Require evidence for AI responses
REQUIRE_AI_EVIDENCE=true

# Require citations for RAG responses
REQUIRE_RAG_CITATIONS=true

# Do not allow unsupported claims.
GROUNDED_RESPONSES_ONLY=true


# ============================================================
# EVALUATION
# ============================================================

EVALUATION_ENABLED=true

# Number of evaluation cases
EVALUATION_TOP_K=10

# Enable retrieval evaluation
EVALUATE_RETRIEVAL=true

# Enable citation evaluation
EVALUATE_CITATIONS=true

# Enable groundedness evaluation
EVALUATE_GROUNDEDNESS=true

# Enable answer evaluation
EVALUATE_ANSWER_ACCURACY=true


# ============================================================
# OBSERVABILITY
# ============================================================

LOG_LEVEL=INFO

ENABLE_REQUEST_LOGGING=true

ENABLE_AI_USAGE_LOGGING=true

ENABLE_RAG_LOGGING=true

ENABLE_QUERY_LOGGING=true

# Do NOT log secrets, tokens, passwords or full credentials.
REDACT_SECRETS_FROM_LOGS=true


# ============================================================
# DEVELOPMENT
# ============================================================

DEBUG=true

RELOAD=true

# API documentation
ENABLE_API_DOCS=true


# ============================================================
# DEMO DATA
# ============================================================

DEMO_DATA_ENABLED=true

DEMO_DATA_PATH=./data/demo

# Automatically load demo data on first setup.
# Set false in production.
AUTO_SEED_DEMO_DATA=true


# ============================================================
# FEATURE FLAGS
# ============================================================

FEATURE_RAG=true

FEATURE_HYBRID_SEARCH=true

FEATURE_ANALYTICS=true

FEATURE_AI_INSIGHTS=true

FEATURE_AI_RECOMMENDATIONS=true

FEATURE_EXECUTIVE_BRIEF=true

FEATURE_DATA_QUALITY=true

FEATURE_EVALUATION=true

FEATURE_LINEAGE=true

FEATURE_WHAT_IF=false


# ============================================================
# APPLICATION URLs
# ============================================================

# Backend
BACKEND_URL=http://localhost:8000

# Frontend
FRONTEND_URL=http://localhost:5173

# API
API_URL=http://localhost:8000/api/v1

# Health endpoint
HEALTH_URL=http://localhost:8000/health