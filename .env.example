# ═══════════════════════════════════════════════════════════════════
# QueryBridge — Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ── PostgreSQL ──
POSTGRES_DB=ragsql
POSTGRES_USER=ragsql
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# ── Redis ──
REDIS_PORT=6379

# ── Backend API ──
API_PORT=8000
LOG_LEVEL=INFO

# ── LLM Provider ──
# Options: "groq" | "nvidia" | "ollama" | "fallback"
# RECOMMENDED: "groq" for fastest inference (~100-500ms vs 30-50s)
LLM_BACKEND=groq
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_TIMEOUT_SECONDS=30

# ── Groq (Ultra-fast LPU inference) ──
# Get your API key at: https://console.groq.com/keys
# Models: llama-3.3-70b-versatile (best), llama-3.1-8b-instant (fastest)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ── Latency Optimization ──
ENABLE_QUERY_CACHE=true
QUERY_CACHE_TTL=300
ENABLE_TEMPLATE_SYNTHESIS=true

# ── Embeddings ──
# Options: "tfidf" | "sentence-transformers"
EMBEDDING_BACKEND=tfidf

# ── Frontend ──
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Nginx ──
NGINX_PORT=80

# ── Security ──
SECRET_KEY=change_me_in_production
