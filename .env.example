# ═══════════════════════════════════════════════════════════════════
# QueryBridge — Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ── PostgreSQL ──
POSTGRES_DB=ragsql
POSTGRES_USER=ragsql
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# ── Redis ──
REDIS_PORT=6379

# ── Backend API ──
API_PORT=8000
LOG_LEVEL=INFO

# ── LLM Provider ──
# Options: "groq" | "nvidia" | "ollama" | "fallback"
# RECOMMENDED: "groq" for fastest inference (~100-500ms vs 30-50s)
LLM_BACKEND=groq
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_TIMEOUT_SECONDS=30
# Nemotron emits a verbose "thinking process" scaffold by default. Set to "none"
# for clean, fast answers (~0.6s vs 10-25s); omit or set to "low"/"medium" to
# keep reasoning for genuinely complex synthesis when NVIDIA is the fallback.
NVIDIA_REASONING_EFFORT=none

# ── Groq (Ultra-fast LPU inference, primary synthesis provider) ──
# Get your API key at: https://console.groq.com/keys
# Valid models include: openai/gpt-oss-120b, openai/gpt-oss-20b,
# llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=8

# ── Latency Optimization ──
ENABLE_QUERY_CACHE=true
QUERY_CACHE_TTL=300
ENABLE_TEMPLATE_SYNTHESIS=true

# ── Embeddings ──
# Options: "tfidf" | "sentence-transformers"
EMBEDDING_BACKEND=tfidf

# ── Frontend ──
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Nginx ──
NGINX_PORT=80

# ── Security ──
SECRET_KEY=change_me_in_production
